# Local Firebase emulators: npm run dev:emulator, e2e and integration tests.
# A "demo-" project ID never reaches real Firebase, so these values are not secrets.
VITE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-news.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-news
VITE_FIREBASE_STORAGE_BUCKET=demo-news.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_MEASUREMENT_ID=
