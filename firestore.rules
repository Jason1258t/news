rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /articles/{article} {
      allow read: if true; // Все могут читать статьи
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /editors-pick/{pick} {
    	allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /horoscopes/{horoscope} {
    	allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /todos/{todo} {
    	allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Счётчики посещений: один документ на день (id — дата YYYY-MM-DD по Москве),
    // { visits, entries: { <источник>: число }, articles: { <slug>: число },
    // articleSources: { <slug>: { <источник>: число } }, likes }. Читатели только прибавляют +1
    // (likes — ещё и −1 при снятии лайка) к сегодняшнему дню, читать может только админ.
    match /stats/{day} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create, update: if isRecentDay(day)
        && (isVisitIncrement() || isArticleViewIncrement() || isLikeChange());
    }

    // Лайки: likes/{slug} = { count }, likes/{slug}/voters/{uid} = {} — кто лайкнул.
    // Читатель входит анонимно (Firebase Anonymous Auth), uid живёт в браузере как кука.
    // Лайк и его отмена — одна пакетная запись: документ голосующего появляется (исчезает)
    // вместе с count ± 1, поэтому один uid даёт не больше одного лайка на статью.
    match /likes/{slug} {
      allow read: if true;
      allow create, update: if request.auth != null
        && exists(/databases/$(database)/documents/articles/$(slug))
        && request.resource.data.keys().hasOnly(['count'])
        && (isLike(slug) || isUnlike(slug));

      match /voters/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().size() == 0
          && getAfter(likesPath(slug)).data.count == likeCount(slug) + 1;
        allow delete: if request.auth != null && request.auth.uid == uid
          && getAfter(likesPath(slug)).data.count == likeCount(slug) - 1;
      }
    }

    function likesPath(slug) {
      return /databases/$(database)/documents/likes/$(slug);
    }

    function voterPath(slug) {
      return /databases/$(database)/documents/likes/$(slug)/voters/$(request.auth.uid);
    }

    function likeCount(slug) {
      return exists(likesPath(slug)) ? get(likesPath(slug)).data.count : 0;
    }

    function isLike(slug) {
      return request.resource.data.count == likeCount(slug) + 1
        && !exists(voterPath(slug)) && existsAfter(voterPath(slug));
    }

    function isUnlike(slug) {
      return request.resource.data.count == likeCount(slug) - 1
        && exists(voterPath(slug)) && !existsAfter(voterPath(slug));
    }

    // День документа близок к текущему времени (с запасом на часовой пояс и неточные часы).
    function isRecentDay(day) {
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && duration.abs(request.time - timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10])))
          < duration.value(36, 'h');
    }

    function statsBefore() {
      return resource == null ? {} : resource.data;
    }

    // Источники, как TRAFFIC_SOURCES в entities/site-stats/model/sources.ts.
    function sourceKeys() {
      return ['feed', 'picks', 'site', 'telegram', 'search', 'external', 'direct'];
    }

    // В карте `after` по сравнению с `before` вырос на 1 ровно ключ `key`, остальное не тронуто.
    function isOneKeyIncrement(before, after, key) {
      return after is map
        && after.diff(before).affectedKeys() == [key].toSet()
        && after.diff(before).removedKeys().size() == 0
        && after[key] == before.get(key, 0) + 1;
    }

    // +1 сеанс и, если клиент его прислал, +1 к источнику входа из lastEntry.
    // Без источника — запись старого клиента, её тоже принимаем.
    function isVisitIncrement() {
      let keys = request.resource.data.diff(statsBefore()).affectedKeys();
      let source = request.resource.data.get('lastEntry', '');
      return keys.hasOnly(['visits', 'entries', 'lastEntry'])
        && request.resource.data.visits == statsBefore().get('visits', 0) + 1
        && (!keys.hasAny(['entries', 'lastEntry'])
          || (source in sourceKeys()
            && isOneKeyIncrement(statsBefore().get('entries', {}),
                request.resource.data.get('entries', {}), source)));
    }

    // Прирост лайков за день меняется на ±1 только вместе с самим лайком в той же пакетной
    // записи: документ голосующего для статьи из lastLiked появляется (+1) или исчезает (−1).
    function isLikeChange() {
      let slug = request.resource.data.get('lastLiked', '');
      let before = statsBefore().get('likes', 0);
      let after = request.resource.data.get('likes', 0);
      return request.auth != null
        && request.resource.data.diff(statsBefore()).affectedKeys().hasOnly(['likes', 'lastLiked'])
        && slug is string
        && slug.matches('^[a-z0-9-]{1,120}$')
        && ((after == before + 1 && !exists(voterPath(slug)) && existsAfter(voterPath(slug)))
          || (after == before - 1 && exists(voterPath(slug)) && !existsAfter(voterPath(slug))));
    }

    // В articleSources.<slug> вырос на 1 ровно счётчик источника из lastSource.
    function isArticleSourceIncrement(slug) {
      let source = request.resource.data.get('lastSource', '');
      let before = statsBefore().get('articleSources', {});
      let after = request.resource.data.get('articleSources', {});
      return source in sourceKeys()
        && after is map
        && after.diff(before).affectedKeys() == [slug].toSet()
        && after.diff(before).removedKeys().size() == 0
        && isOneKeyIncrement(before.get(slug, {}), after[slug], source);
    }

    // Ровно один счётчик в articles вырос на 1, и это существующая статья. Достать ключ
    // из diff правила не умеют, поэтому клиент дублирует slug в поле lastArticle.
    function isArticleViewIncrement() {
      let before = statsBefore().get('articles', {});
      let after = request.resource.data.get('articles', {});
      let slug = request.resource.data.get('lastArticle', '');
      let keys = request.resource.data.diff(statsBefore()).affectedKeys();
      return keys.hasOnly(['articles', 'lastArticle', 'articleSources', 'lastSource'])
        && (!keys.hasAny(['articleSources', 'lastSource']) || isArticleSourceIncrement(slug))
        && slug is string
        && slug.matches('^[a-z0-9-]{1,120}$')
        && after is map
        && after.diff(before).affectedKeys() == [slug].toSet()
        && after.diff(before).removedKeys().size() == 0
        && after[slug] == before.get(slug, 0) + 1
        && exists(/databases/$(database)/documents/articles/$(slug));
    }
  }

}
