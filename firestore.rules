rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /articles/{article} {
      allow read: if true; // Все могут читать статьи
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /editors-pick/{pick} {
    	allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /horoscopes/{horoscope} {
    	allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /todos/{todo} {
    	allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Счётчики посещений: один документ на день (id — дата YYYY-MM-DD по Москве),
    // { visits: число, articles: { <slug>: число } }. Читатели только прибавляют +1
    // к сегодняшнему дню, читать может только админ.
    match /stats/{day} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create, update: if isRecentDay(day) && (isVisitIncrement() || isArticleViewIncrement());
    }

    // Лайки: likes/{slug} = { count }, likes/{slug}/voters/{uid} = {} — кто лайкнул.
    // Читатель входит анонимно (Firebase Anonymous Auth), uid живёт в браузере как кука.
    // Лайк и его отмена — одна пакетная запись: документ голосующего появляется (исчезает)
    // вместе с count ± 1, поэтому один uid даёт не больше одного лайка на статью.
    match /likes/{slug} {
      allow read: if true;
      allow create, update: if request.auth != null
        && exists(/databases/$(database)/documents/articles/$(slug))
        && request.resource.data.keys().hasOnly(['count'])
        && (isLike(slug) || isUnlike(slug));

      match /voters/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().size() == 0
          && getAfter(likesPath(slug)).data.count == likeCount(slug) + 1;
        allow delete: if request.auth != null && request.auth.uid == uid
          && getAfter(likesPath(slug)).data.count == likeCount(slug) - 1;
      }
    }

    function likesPath(slug) {
      return /databases/$(database)/documents/likes/$(slug);
    }

    function voterPath(slug) {
      return /databases/$(database)/documents/likes/$(slug)/voters/$(request.auth.uid);
    }

    function likeCount(slug) {
      return exists(likesPath(slug)) ? get(likesPath(slug)).data.count : 0;
    }

    function isLike(slug) {
      return request.resource.data.count == likeCount(slug) + 1
        && !exists(voterPath(slug)) && existsAfter(voterPath(slug));
    }

    function isUnlike(slug) {
      return request.resource.data.count == likeCount(slug) - 1
        && exists(voterPath(slug)) && !existsAfter(voterPath(slug));
    }

    // День документа близок к текущему времени (с запасом на часовой пояс и неточные часы).
    function isRecentDay(day) {
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && duration.abs(request.time - timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10])))
          < duration.value(36, 'h');
    }

    function statsBefore() {
      return resource == null ? {} : resource.data;
    }

    function isVisitIncrement() {
      return request.resource.data.diff(statsBefore()).affectedKeys().hasOnly(['visits'])
        && request.resource.data.visits == statsBefore().get('visits', 0) + 1;
    }

    // Ровно один счётчик в articles вырос на 1, и это существующая статья. Достать ключ
    // из diff правила не умеют, поэтому клиент дублирует slug в поле lastArticle.
    function isArticleViewIncrement() {
      let before = statsBefore().get('articles', {});
      let after = request.resource.data.get('articles', {});
      let slug = request.resource.data.get('lastArticle', '');
      return request.resource.data.diff(statsBefore()).affectedKeys().hasOnly(['articles', 'lastArticle'])
        && slug is string
        && slug.matches('^[a-z0-9-]{1,120}$')
        && after is map
        && after.diff(before).affectedKeys() == [slug].toSet()
        && after.diff(before).removedKeys().size() == 0
        && after[slug] == before.get(slug, 0) + 1
        && exists(/databases/$(database)/documents/articles/$(slug));
    }
  }

}
