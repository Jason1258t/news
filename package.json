{
    "name": "news-website",
    "homepage": "https://vtech-news.ru",
    "version": "0.1.0",
    "private": true,
    "dependencies": {
        "@tanstack/react-query": "^5.90.2",
        "dompurify": "^3.4.16",
        "firebase": "^12.19.0",
        "katex": "^0.19.0",
        "linkify-react": "^4.3.3",
        "linkifyjs": "^4.3.3",
        "lucide-react": "^0.546.0",
        "prismjs": "^1.30.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-helmet-async": "^2.0.5",
        "react-hot-toast": "^2.6.0",
        "react-intersection-observer": "^9.16.0",
        "react-router-dom": "^7.9.3",
        "zod": "^4.6.5",
        "zustand": "^5.0.8"
    },
    "scripts": {
        "dev": "vite",
        "start": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:run",
        "test": "vitest",
        "test:run": "vitest run",
        "coverage": "vitest run --coverage",
        "test:rules": "firebase emulators:exec --only firestore --project demo-news-rules \"vitest run --config vitest.rules.config.ts\"",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist"
    },
    "devDependencies": {
        "@emnapi/core": "^1.10.0",
        "@emnapi/runtime": "^1.10.0",
        "@eslint/js": "^10.0.1",
        "@firebase/rules-unit-testing": "^5.0.2",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/katex": "^0.16.8",
        "@types/node": "^24.19.1",
        "@types/prismjs": "^1.26.6",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.3",
        "eslint": "^10.12.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.2.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "firebase-tools": "^15.33.0",
        "gh-pages": "^6.3.0",
        "globals": "^17.13.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.9",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.3",
        "vitest": "^5.0.3"
    },
    "type": "module",
    "engines": {
        "node": ">=22"
    }
}
